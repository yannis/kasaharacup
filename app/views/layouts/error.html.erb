<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("error_pages.statuses.#{@status}.title", default: t("error_pages.statuses.default.title")) %> — Kasahara Cup</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%# No csrf_meta_tags: it writes session[:_csrf_token], which raises when the session is absent. %>
    <%= favicon_link_tag "favicon/favicon.svg", rel: "icon", type: "image/svg+xml" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="bg-gray-50 flex flex-col h-full">
    <div class="flex flex-col h-screen justify-between">
      <nav class="bg-red-700">
        <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
          <div class="relative flex items-center justify-between h-16">
            <%# root_path, never "/": routes.rb ends with redirect(I18n.locale.to_s), whose
                argument is evaluated once when routes are drawn, so "/" is permanently French. %>
            <%= link_to root_path(locale: I18n.locale) do %>
              <%= image_tag "logo/logo.png", class: "block h-9 w-auto", alt: "logo" %>
            <% end %>
            <%= link_to t("error_pages.switch_locale"),
                  error_path(@status, locale: (I18n.locale == :fr) ? :en : :fr),
                  class: "text-gray-300 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
          </div>
        </div>
      </nav>
      <main class="flex-1 pb-20"><%= yield %></main>
      <footer class="bg-white">
        <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 text-base text-gray-400">
          &copy; <%= Date.current.year %> Kasahara Cup
        </div>
      </footer>
    </div>
  </body>
</html>
