<div class="max-w-7xl mx-auto py-3 px-3 sm:px-6 lg:px-8">
  <div class="prose prose-red-900 prose-lg text-gray-900 mx-auto py-10">
    <p class="text-red-700 font-semibold not-prose"><%= @status %></p>
    <h1><%= t("error_pages.statuses.#{@status}.title", default: t("error_pages.statuses.default.title")) %></h1>
    <p><%= t("error_pages.statuses.#{@status}.message", default: t("error_pages.statuses.default.message")) %></p>
    <ul>
      <li><%= link_to t("error_pages.links.home"), root_path(locale: I18n.locale) %></li>
      <li><%= link_to t("error_pages.links.rules"), rules_path(locale: I18n.locale) %></li>
      <% if ENV["CONTACT_EMAIL"].present? %>
        <li>
          <%= mail_to ENV["CONTACT_EMAIL"], t("error_pages.links.contact"),
                encode: "hex", replace_at: "_at_", replace_dot: "_dot_" %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
